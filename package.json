{
  "name": "agentlens",
  "version": "0.1.0",
  "description": "Local observability for Claude Code and Codex sessions, with a desktop dashboard and read-only CLI/MCP tools.",
  "license": "MIT",
  "author": "Ayman Laassel",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "homepage": "https://github.com/aymanlaassel/agentlens",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main && npm run build:cli",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "build:cli": "node scripts/build-cli.mjs",
    "cli": "node dist-cli/index.cjs",
    "test:cli": "npm run build:cli && node scripts/smoke-cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@xyflow/react": "12.12.0",
    "chokidar": "6.0.0",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "bin": {
    "agentlens": "dist-cli/index.cjs"
  }
}
